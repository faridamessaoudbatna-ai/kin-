            gsap.to(child.group.position, { x: 0, y: 0.96, z: -0.25, duration: 0.55 });
            gsap.to(kleinBall.position, { z: 0.18, duration: 0.45, yoyo: true, repeat: 1 });
            gsap.to(child.headPivot.rotation, { x: -0.55, y: 0, z: 0, duration: 0.6 });
            showToast('Stade III : déséquilibres sur ballon de Klein ➔ réaction réflexe de redressement');
          } else if (mode === 'mirror_minerve') {
            kleinBall.visible = false;
            braceGroup.visible = false;
            gsap.to(child.group.rotation, { x: 0, y: Math.PI, z: 0, duration: 0.55 });
            gsap.to(child.group.position, { x: 0, y: 0.04, z: -0.25, duration: 0.55 });
            gsap.to(child.headPivot.rotation, { x: -0.08, y: -0.45, z: 0, duration: 0.65 });
            showToast('Post-op (Minerve retirée) : étirement & autograndissement face au miroir');
          } else if (mode === 'milwaukee_protocol') {
            kleinBall.visible = false;
            braceGroup.visible = true;
            gsap.to(child.group.rotation, { x: 0, y: 0, z: 0, duration: 0.55 });
            gsap.to(child.group.position, { x: 0, y: 0.04, z: 0.05, duration: 0.55 });
            gsap.to(child.headPivot.rotation, { x: -0.05, y: 0.45, z: 0, duration: 0.6, yoyo: true, repeat: 1 });
            showToast('Corset de Milwaukee : allongement axial actif + rotations (épaules stabilisées)');
          }
        }
        setStage3Mode('klein_ball_tilt');

        currentSceneController = {
          trigger(actionId) {
            setStage3Mode(actionId);
          }
        };
      }

      buildPageLabels(lesson);

      // Pop-up spring animation (scale.y from 0.01 to 1.0, staggered)
      spawnables.forEach((obj, i) => {
        if (state.reducedMotion) {
          obj.scale.y = 1;
        } else {
          obj.scale.y = 0.01;
          gsap.to(obj.scale, {
            y: 1.0,
            duration: 0.72,
            delay: 0.08 + i * 0.07,
            ease: 'elastic.out(1, 0.55)'
          });
        }
      });
    }

    // =========================================================================
    // 8. LEFT PAGE HTML RENDERER (Content, Flap, Experiments, Vocab, Quiz)
    // =========================================================================
    function renderLeftPage(index) {
      const lesson = LESSONS[index];
      const inner = document.getElementById('left-page-inner');

      const expButtonsHtml = lesson.sceneDescription.interactions.map(inter =>
        `<button class="exp-btn" data-action="${inter.id}">⚡ ${inter.label}</button>`
      ).join('');

      const vocabHtml = lesson.vocabulary.map(v =>
        `<div class="vocab-item"><strong>${v.term}</strong><span>${v.definition}</span></div>`
      ).join('');

      const tasksHtml = lesson.tasks.map(t => `<li>${t}</li>`).join('');

      const quizOptsHtml = lesson.quiz.options.map((opt, idx) =>
        `<button class="quiz-opt" data-idx="${idx}">${String.fromCharCode(65 + idx)}. ${opt}</button>`
      ).join('');

      inner.innerHTML = `
        <div class="page-header">
          <span class="lesson-badge">LEÇON ${lesson.number} / ${LESSONS.length}</span>
          <span class="course-tag">${SCHEMA.meta.course}</span>
        </div>
        <h1 class="page-title">${lesson.title}</h1>
        <p class="page-subtitle">${lesson.subtitle}</p>

        <div class="summary-box">${lesson.summary}</div>
        <div class="formula-pill">📐 ${lesson.formula}</div>

        <div class="flap-wrapper">
          <button class="flap-toggle-btn" id="page-flap-btn" aria-expanded="false">
            <span>${lesson.flap.buttonLabel}</span>
            <span id="flap-arrow">▼</span>
          </button>
          <div class="flap-card" id="page-flap-card">
            <h4>${lesson.flap.title}</h4>
            <pre>${lesson.flap.content}</pre>
          </div>
        </div>

        <div class="section-label">Manipulations 3D sur la page droite</div>
        <div class="exp-controls">${expButtonsHtml}</div>

        <div class="section-label">Vocabulaire clinique clé</div>
        <div class="vocab-grid">${vocabHtml}</div>

        <div class="section-label">Objectifs pratiques à tester</div>
        <ul class="task-list">${tasksHtml}</ul>

        <div class="quiz-box">
          <p class="quiz-q">❓ Auto-évaluation : ${lesson.quiz.question}</p>
          ${quizOptsHtml}
          <div class="quiz-feedback" id="quiz-feedback"></div>
        </div>
      `;

      leftPageEl.scrollTop = 0;

      // Flap toggle listener
      const flapBtn = document.getElementById('page-flap-btn');
      const flapCard = document.getElementById('page-flap-card');
      const flapArrow = document.getElementById('flap-arrow');
      flapBtn.addEventListener('click', () => {
        const isOpen = flapCard.classList.toggle('open');
        flapBtn.setAttribute('aria-expanded', String(isOpen));
        flapArrow.textContent = isOpen ? '▲' : '▼';
        synth.playPop(isOpen);
      });

      // Experiment buttons
      inner.querySelectorAll('.exp-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          inner.querySelectorAll('.exp-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          synth.playClick(580);
          if (currentSceneController) {
            currentSceneController.trigger(btn.dataset.action);
          }
        });
      });

      // Quiz buttons
      inner.querySelectorAll('.quiz-opt').forEach(btn => {
        btn.addEventListener('click', () => {
          const chosen = Number(btn.dataset.idx);
          const correct = lesson.quiz.correctIndex;
          inner.querySelectorAll('.quiz-opt').forEach((b, i) => {
            b.classList.remove('correct', 'wrong');
            if (i === correct) b.classList.add('correct');
            else if (i === chosen) b.classList.add('wrong');
          });
          const fb = document.getElementById('quiz-feedback');
          if (chosen === correct) {
            synth.playChime(true);
            fb.textContent = '✅ Exact ! ' + lesson.quiz.explanation;
          } else {
            synth.playChime(false);
            fb.textContent = '💡 Pas tout à fait. ' + lesson.quiz.explanation;
          }
        });
      });
    }

    // =========================================================================
    // 9. PAGE TURN TRANSITION (3D Curling Sheet + Fold Down / Pop Up)
    // =========================================================================
    function goToLesson(targetIndex) {
      if (targetIndex < 0 || targetIndex >= LESSONS.length) return;
      if (targetIndex === state.currentIndex || state.isFlipping) return;

      stopDemo(false);
      closeToc();

      const forward = targetIndex > state.currentIndex;
      state.currentIndex = targetIndex;
      updateHud();

      if (state.reducedMotion) {
        renderLeftPage(targetIndex);
        buildLessonScene(targetIndex);
        return;
      }

      state.isFlipping = true;
      controls.enabled = false;
      synth.playRustle();

      // Fold current 3D models down into the page
      gsap.to(popupRoot.scale, { y: 0.01, duration: 0.28, ease: 'power2.in' });

      turningSheet.visible = true;
      const flipObj = { t: forward ? 0 : 1 };
      deformTurningSheet(flipObj.t);

      gsap.to(flipObj, {
        t: forward ? 1 : 0,
        duration: 0.78,
        ease: 'power2.inOut',
        onUpdate: () => deformTurningSheet(flipObj.t),
        onComplete: () => {
          turningSheet.visible = false;
          popupRoot.scale.y = 1;
          renderLeftPage(targetIndex);
          buildLessonScene(targetIndex);
          synth.playPop(true);
          state.isFlipping = false;
          controls.enabled = true;
        }
      });
    }

    // =========================================================================
    // 10. GUIDED DEMO ENGINE (Camera Paths + Captions + Actions)
    // =========================================================================
    const captionBar = document.getElementById('caption-bar');
    const toastEl = document.getElementById('toast');
    let toastTimer = null;

    function showCaption(text) {
      captionBar.textContent = text;
      captionBar.classList.add('visible');
    }
    function hideCaption() {
      captionBar.classList.remove('visible');
    }
    function showToast(text) {
      toastEl.textContent = text;
      toastEl.classList.add('visible');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.remove('visible'), 2600);
    }

    function startDemo() {
      if (state.isFlipping) return;
      if (state.isDemoPlaying) {
        stopDemo(false);
        return;
      }
      state.isDemoPlaying = true;
      controls.enabled = false;
      document.getElementById('btn-demo').classList.add('active');
      document.getElementById('btn-demo').textContent = '⏸ Stop';
      synth.playClick(640);

      const steps = LESSONS[state.currentIndex].demoSteps;
      let stepIdx = 0;

      function runStep() {
        if (!state.isDemoPlaying) return;
        if (stepIdx >= steps.length) {
          stopDemo(false);
          showToast('Démo guidée terminée');
          return;
        }
        const step = steps[stepIdx];
        showCaption(step.caption);
        if (currentSceneController && step.action) {
          currentSceneController.trigger(step.action);
        }

        const tx = step.cameraTarget[0];
        const ty = step.cameraTarget[1];
        const tz = step.cameraTarget[2];
        const cx = tx + step.cameraOffset[0];
        const cy = ty + step.cameraOffset[1];
        const cz = tz + step.cameraOffset[2];

        if (state.reducedMotion) {
          controls.target.set(tx, ty, tz);
          camera.position.set(cx, cy, cz);
          controls.update();
        } else {
          gsap.to(controls.target, {
            x: tx, y: ty, z: tz, duration: 1.0, ease: 'power2.inOut',
            onUpdate: () => controls.update()
          });
          gsap.to(camera.position, { x: cx, y: cy, z: cz, duration: 1.0, ease: 'power2.inOut' });
        }

        stepIdx++;
        const timer = setTimeout(runStep, 3400);
        state.demoTimers.push(timer);
      }

      runStep();
    }

    function stopDemo(userInterrupted = false) {
      state.demoTimers.forEach(t => clearTimeout(t));
      state.demoTimers = [];
      if (!state.isDemoPlaying) return;
      state.isDemoPlaying = false;
      controls.enabled = true;
      document.getElementById('btn-demo').classList.remove('active');
      document.getElementById('btn-demo').textContent = '▶ Démo';
      hideCaption();
      if (userInterrupted) {
        showToast('Contrôle manuel repris');
      }
    }

    // =========================================================================
    // 11. CLICK VS DRAG RAYCASTING ON 3D POP-UP MODELS
    // =========================================================================
    const raycaster = new THREE.Raycaster();
    const pointerNdc = new THREE.Vector2();
    let pointerDownInfo = null;
    let activeTouchCount = 0;

    renderer.domElement.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') activeTouchCount++;
      if (activeTouchCount > 1) {
        pointerDownInfo = null; // Cancel tap during multi-touch pinch/pan
        return;
      }
      pointerDownInfo = { x: e.clientX, y: e.clientY, time: performance.now() };
    });

    renderer.domElement.addEventListener('pointerup', (e) => {
      if (e.pointerType === 'touch') activeTouchCount = Math.max(0, activeTouchCount - 1);
      if (!pointerDownInfo) return;
      const dx = e.clientX - pointerDownInfo.x;
      const dy = e.clientY - pointerDownInfo.y;
      const dt = performance.now() - pointerDownInfo.time;
      pointerDownInfo = null;

      // Strict click vs drag threshold (< 6px movement and < 350ms)
      if (Math.hypot(dx, dy) > 6 || dt > 350) return;

      const rect = renderer.domElement.getBoundingClientRect();
      pointerNdc.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      pointerNdc.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
      raycaster.setFromCamera(pointerNdc, camera);
      const hits = raycaster.intersectObjects(state.interactiveMeshes, true);
      if (hits.length > 0) {
        let obj = hits[0].object;
        while (obj && !obj.userData?.actionId) obj = obj.parent;
        if (obj && obj.userData?.actionId && currentSceneController) {
          synth.playClick(620);
          currentSceneController.trigger(obj.userData.actionId);
        }
      }
    });

    // =========================================================================
    // 12. HUD, TOC DRAWER, THEMES & KEYBOARD SHORTCUTS
    // =========================================================================
    const tocDrawer = document.getElementById('toc-drawer');
    const tocList = document.getElementById('toc-list');

    function buildToc() {
      tocList.innerHTML = LESSONS.map((l, idx) => `
        <button class="toc-item ${idx === state.currentIndex ? 'current' : ''}" data-idx="${idx}">
          <span class="toc-num">${l.number}</span>
          <span>${l.title}</span>
        </button>
      `).join('');
      tocList.querySelectorAll('.toc-item').forEach(btn => {
        btn.addEventListener('click', () => goToLesson(Number(btn.dataset.idx)));
      });
    }

    function toggleToc() {
      const opening = !tocDrawer.classList.contains('open');
      if (opening) {
        buildToc();
        tocDrawer.classList.add('open');
      } else {
        closeToc();
      }
    }
    function closeToc() {
      tocDrawer.classList.remove('open');
    }

    function updateHud() {
      const l = LESSONS[state.currentIndex];
      document.getElementById('hud-lesson-indicator').textContent = `${l.number}/${LESSONS.length} • ${l.title}`;
      document.getElementById('btn-prev').disabled = state.currentIndex === 0;
      document.getElementById('btn-next').disabled = state.currentIndex === LESSONS.length - 1;
    }

    document.getElementById('btn-toc').addEventListener('click', toggleToc);
    document.getElementById('btn-prev').addEventListener('click', () => goToLesson(state.currentIndex - 1));
    document.getElementById('btn-next').addEventListener('click', () => goToLesson(state.currentIndex + 1));
    document.getElementById('btn-demo').addEventListener('click', startDemo);
    document.getElementById('btn-reset').addEventListener('click', () => {
      stopDemo(false);
      resetCamera(false);
      synth.playClick(440);
    });

    document.getElementById('btn-sound').addEventListener('click', (e) => {
      state.soundEnabled = !state.soundEnabled;
      e.currentTarget.textContent = state.soundEnabled ? '🔊' : '🔇';
      if (state.soundEnabled) synth.playClick(600);
      showToast(state.soundEnabled ? 'Son activé' : 'Son coupé');
    });

    const themes = [
      { cls: '', icon: '☀️', label: 'Thème Jour', bg: '#232b35' },
      { cls: 'theme-night', icon: '🌙', label: 'Thème Nuit', bg: '#0f1319' },
      { cls: 'theme-contrast', icon: '◐', label: 'Contraste Élevé', bg: '#111111' }
    ];
    document.getElementById('btn-theme').addEventListener('click', (e) => {
      state.themeIndex = (state.themeIndex + 1) % themes.length;
      const th = themes[state.themeIndex];
      document.body.className = th.cls;
      e.currentTarget.textContent = th.icon;
      scene.background.set(th.bg);
      scene.fog.color.set(th.bg);
      // Rebuild labels to match theme contrast
      buildPageLabels(LESSONS[state.currentIndex]);
      showToast(th.label);
    });

    const motionBtn = document.getElementById('btn-motion');
    function syncMotionBtn() {
      motionBtn.classList.toggle('active', state.reducedMotion);
      motionBtn.textContent = state.reducedMotion ? '⏸️' : '🎞️';
    }
    syncMotionBtn();
    motionBtn.addEventListener('click', () => {
      state.reducedMotion = !state.reducedMotion;
      syncMotionBtn();
      showToast(state.reducedMotion ? 'Animations réduites activées' : 'Animations complètes activées');
    });

    window.addEventListener('keydown', (e) => {
      if (e.target && ['INPUT', 'TEXTAREA'].includes(e.target.tagName)) return;
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        goToLesson(state.currentIndex + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goToLesson(state.currentIndex - 1);
      } else if (e.key === ' ') {
        e.preventDefault();
        startDemo();
      } else if (e.key === 'r' || e.key === 'R') {
        stopDemo(false);
        resetCamera(false);
      } else if (e.key === 'Escape') {
        stopDemo(false);
        closeToc();
      }
    });

    // =========================================================================
    // 13. RESIZE & MAIN RENDER LOOP (Wait for Web Fonts before Canvas Labels)
    // =========================================================================
    function onResize() {
      const w = window.innerWidth || 1280;
      const h = window.innerHeight || 800;
      camera.aspect = getSafeAspect();
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
      composer.setSize(w, h);
      cssRenderer.setSize(w, h);
    }
    window.addEventListener('resize', onResize);

    const clock = new THREE.Clock();
    function animate() {
      requestAnimationFrame(animate);
      const elapsed = clock.getElapsedTime();
      postPass.uniforms.uTime.value = elapsed;
      if (controls.enabled) controls.update();
      composer.render();
      cssRenderer.render(scene, camera);
    }

    // Boot after fonts are loaded so 2D canvas labels render in Plus Jakarta Sans
    const boot = () => {
      renderLeftPage(0);
      buildLessonScene(0);
      updateHud();
      animate();
    };

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(boot);
    } else {
      boot();
    }
  </script>
</body>
</html>
