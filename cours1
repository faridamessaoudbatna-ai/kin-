  <style>
    :root {
      --bg-hud: rgba(252, 249, 242, 0.92);
      --bg-page: #fcf8ef;
      --bg-card: #f3ece0;
      --text-main: #22252a;
      --text-muted: #555c66;
      --accent: #1d6b64;
      --accent-soft: #e0f0ed;
      --warn: #c44536;
      --border: #d9cfc0;
      --shadow: 0 10px 30px rgba(20, 24, 30, 0.18);
    }
    body.theme-night {
      --bg-hud: rgba(24, 28, 36, 0.92);
      --bg-page: #1e232d;
      --bg-card: #28303d;
      --text-main: #eef2f7;
      --text-muted: #a6b0c0;
      --accent: #4ecdc4;
      --accent-soft: rgba(78, 205, 196, 0.16);
      --warn: #ff6b6b;
      --border: #3a4454;
      --shadow: 0 12px 34px rgba(0, 0, 0, 0.45);
    }
    body.theme-contrast {
      --bg-hud: #000000;
      --bg-page: #ffffff;
      --bg-card: #f0f0f0;
      --text-main: #000000;
      --text-muted: #111111;
      --accent: #0044cc;
      --accent-soft: #dce8ff;
      --warn: #b30000;
      --border: #000000;
      --shadow: 0 6px 0 #000000;
    }

    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    html, body {
      margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #1b222c;
      color: var(--text-main);
      user-select: none;
    }

    #webgl-container {
      position: fixed; inset: 0; z-index: 1;
    }
    /* Robustness: force LTR on CSS3D container so 3D transforms never offset in RTL */
    #css3d-container {
      position: fixed; inset: 0; z-index: 2; pointer-events: none; direction: ltr;
    }

    /* Left Page HTML Sheet rendered inside CSS3DRenderer */
    .book-left-page {
      width: 680px;
      height: 860px;
      left: 0;
      top: 0;
      background: var(--bg-page);
      color: var(--text-main);
      border-radius: 16px 4px 4px 16px;
      border: 2px solid var(--border);
      padding: 28px 32px;
      overflow-y: auto;
      pointer-events: auto;
      box-shadow: inset -18px 0 28px rgba(0,0,0,0.06);
      font-size: 14px;
      line-height: 1.5;
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
    }
    .page-header {
      display: flex; justify-content: space-between; align-items: center;
      border-bottom: 2px solid var(--border); padding-bottom: 10px; margin-bottom: 12px;
    }
    .lesson-badge {
      background: var(--accent); color: #fff; font-weight: 700;
      padding: 3px 10px; border-radius: 999px; font-size: 12px; letter-spacing: 0.04em;
    }
    body.theme-night .lesson-badge { color: #0f171e; }
    .course-tag { font-size: 11px; color: var(--text-muted); font-weight: 600; }

    .page-title {
      font-family: 'Crimson Pro', Georgia, serif;
      font-size: 27px; font-weight: 700; line-height: 1.18; margin: 0 0 4px 0;
      color: var(--text-main);
    }
    .page-subtitle {
      font-size: 13px; color: var(--text-muted); margin: 0 0 12px 0; font-weight: 500;
    }
    .summary-box {
      background: var(--bg-card); border-left: 4px solid var(--accent);
      padding: 10px 14px; border-radius: 6px; margin-bottom: 12px; font-size: 13.5px;
    }
    .formula-pill {
      background: var(--accent-soft); color: var(--accent);
      border: 1px dashed var(--accent); border-radius: 8px;
      padding: 8px 12px; font-weight: 700; font-size: 12.5px; margin-bottom: 14px;
      text-align: center;
    }

    /* 3D Interactive Flap on the Page */
    .flap-wrapper {
      perspective: 1100px; margin-bottom: 14px;
    }
    .flap-toggle-btn {
      width: 100%; text-align: left; background: var(--accent); color: #fff;
      border: none; border-radius: 8px; padding: 10px 14px; font-weight: 700;
      font-size: 13px; cursor: pointer; display: flex; justify-content: space-between; align-items: center;
      transition: transform 0.15s ease, opacity 0.15s ease;
    }
    body.theme-night .flap-toggle-btn { color: #0e151b; }
    .flap-toggle-btn:hover { opacity: 0.93; }
    .flap-card {
      transform-origin: top center;
      transform: rotateX(-90deg);
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      background: var(--bg-card);
      border: 1.5px solid var(--accent);
      border-top: none;
      border-radius: 0 0 8px 8px;
      padding: 0 14px;
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), max-height 0.45s ease, opacity 0.3s ease, padding 0.35s ease;
    }
    .flap-card.open {
      transform: rotateX(0deg);
      max-height: 320px;
      opacity: 1;
      padding: 12px 14px;
    }
    .flap-card h4 { margin: 0 0 6px 0; font-size: 13.5px; color: var(--accent); }
    .flap-card pre {
      margin: 0; white-space: pre-wrap; font-family: inherit; font-size: 12.5px; line-height: 1.45;
    }

    /* Section blocks */
    .section-label {
      font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.06em;
      font-weight: 700; color: var(--text-muted); margin: 12px 0 6px 0;
    }

    /* Interactive 3D Experiment Controls right on the page */
    .exp-controls {
      display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 12px;
    }
    .exp-btn {
      background: var(--bg-card); color: var(--text-main);
      border: 1.5px solid var(--accent); border-radius: 8px;
      padding: 7px 11px; font-size: 12.5px; font-weight: 600; cursor: pointer;
      transition: all 0.15s ease;
    }
    .exp-btn:hover, .exp-btn.active {
      background: var(--accent); color: #fff;
    }
    body.theme-night .exp-btn:hover, body.theme-night .exp-btn.active { color: #0f171e; }

    /* Vocabulary Grid */
    .vocab-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px;
    }
    .vocab-item {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 8px; padding: 8px 10px; font-size: 12px;
    }
    .vocab-item strong { display: block; color: var(--accent); margin-bottom: 2px; font-size: 12.5px; }

    /* Tasks */
    .task-list {
      margin: 0 0 12px 0; padding-left: 18px; font-size: 12.5px; color: var(--text-main);
    }
    .task-list li { margin-bottom: 4px; }

    /* Quiz Box */
    .quiz-box {
      background: var(--bg-card); border: 1.5px solid var(--border);
      border-radius: 10px; padding: 12px 14px;
    }
    .quiz-q { font-weight: 700; font-size: 13px; margin: 0 0 8px 0; }
    .quiz-opt {
      display: block; width: 100%; text-align: left;
      background: var(--bg-page); color: var(--text-main);
      border: 1px solid var(--border); border-radius: 7px;
      padding: 7px 10px; margin-bottom: 6px; font-size: 12.5px; cursor: pointer;
      transition: border-color 0.15s, background 0.15s;
    }
    .quiz-opt:hover { border-color: var(--accent); }
    .quiz-opt.correct { background: #d4edda; border-color: #28a745; color: #155724; font-weight: 700; }
    .quiz-opt.wrong { background: #f8d7da; border-color: #dc3545; color: #721c24; }
    .quiz-feedback { font-size: 12px; margin-top: 6px; font-weight: 600; color: var(--accent); }

    /* Floating Caption Bar & Toast */
    #caption-bar {
      position: fixed; top: 16px; left: 50%; transform: translateX(-50%);
      z-index: 20; background: var(--bg-hud); color: var(--text-main);
      border: 1.5px solid var(--accent); border-radius: 14px;
      padding: 10px 20px; max-width: min(680px, 92vw);
      font-size: 14px; font-weight: 600; text-align: center;
      box-shadow: var(--shadow); backdrop-filter: blur(10px);
      opacity: 0; pointer-events: none; transition: opacity 0.25s ease;
    }
    #caption-bar.visible { opacity: 1; }

    #toast {
      position: fixed; bottom: 82px; left: 50%; transform: translateX(-50%) translateY(10px);
      z-index: 25; background: var(--accent); color: #fff;
      padding: 7px 16px; border-radius: 999px; font-size: 13px; font-weight: 600;
      box-shadow: var(--shadow); opacity: 0; pointer-events: none;
      transition: opacity 0.22s ease, transform 0.22s ease;
    }
    body.theme-night #toast { color: #0e151b; }
    #toast.visible { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* Floating Bottom Pill HUD */
    #bottom-hud {
      position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%);
      z-index: 30; display: flex; align-items: center; gap: 6px;
      background: var(--bg-hud); border: 1.5px solid var(--border);
      border-radius: 999px; padding: 7px 14px;
      box-shadow: var(--shadow); backdrop-filter: blur(12px);
      max-width: 96vw; overflow-x: auto;
    }
    .hud-btn {
      background: transparent; color: var(--text-main); border: 1px solid transparent;
      border-radius: 999px; padding: 6px 11px; font-size: 13px; font-weight: 600;
      cursor: pointer; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px;
      transition: background 0.15s, border-color 0.15s;
    }
    .hud-btn:hover { background: var(--accent-soft); border-color: var(--accent); }
    .hud-btn.active { background: var(--accent); color: #fff; }
    body.theme-night .hud-btn.active { color: #0e151b; }
    .hud-sep { width: 1px; height: 20px; background: var(--border); flex-shrink: 0; }
    #hud-lesson-indicator {
      font-size: 13px; font-weight: 700; padding: 0 8px; white-space: nowrap; color: var(--text-main);
    }

    /* Table of Contents Drawer */
    #toc-drawer {
      position: fixed; bottom: 76px; left: 50%; transform: translateX(-50%) scale(0.96);
      z-index: 28; width: min(440px, 92vw);
      background: var(--bg-hud); border: 1.5px solid var(--border);
      border-radius: 16px; padding: 14px; box-shadow: var(--shadow);
      backdrop-filter: blur(14px); opacity: 0; pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    #toc-drawer.open { opacity: 1; pointer-events: auto; transform: translateX(-50%) scale(1); }
    #toc-drawer h3 { margin: 0 0 8px 0; font-size: 14px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
    .toc-item {
      width: 100%; text-align: left; background: transparent; color: var(--text-main);
      border: 1px solid transparent; border-radius: 10px; padding: 8px 11px;
      margin-bottom: 4px; cursor: pointer; font-size: 13px; font-weight: 600;
      display: flex; align-items: center; gap: 10px;
    }
    .toc-item:hover { background: var(--accent-soft); }
    .toc-item.current { background: var(--accent); color: #fff; }
    body.theme-night .toc-item.current { color: #0e151b; }
    .toc-num {
      width: 22px; height: 22px; border-radius: 50%; background: rgba(0,0,0,0.12);
      display: inline-flex; align-items: center; justify-content: center; font-size: 12px; flex-shrink: 0;
    }

    /* Mobile Fallback / Quick Toggle Hint */
    #help-badge {
      position: fixed; top: 16px; right: 16px; z-index: 15;
      background: var(--bg-hud); border: 1px solid var(--border);
      border-radius: 999px; padding: 5px 12px; font-size: 11.5px; color: var(--text-muted);
      backdrop-filter: blur(8px);
    }
    @media (max-width: 720px) {
      #help-badge { display: none; }
      #hud-lesson-indicator { max-width: 130px; overflow: hidden; text-overflow: ellipsis; }
    }
  </style>

