  <script type="module">
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
    import { CSS3DRenderer, CSS3DObject } from 'three/addons/renderers/CSS3DRenderer.js';
    import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
    import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
    import { ShaderPass } from 'three/addons/postprocessing/ShaderPass.js';

    // =========================================================================
    // 1. LOAD SCHEMA & STATE
    // =========================================================================
    const SCHEMA = JSON.parse(document.getElementById('lessons-data').textContent);
    const LESSONS = SCHEMA.lessons;

    const state = {
      currentIndex: 0,
      isFlipping: false,
      isDemoPlaying: false,
      demoTimers: [],
      soundEnabled: true,
      themeIndex: 0, // 0: day, 1: night, 2: contrast
      reducedMotion: window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      activeAction: null,
      interactiveMeshes: [],
      disposables: { geometries: [], materials: [], textures: [] }
    };

    // =========================================================================
    // 2. PROCEDURAL WEB AUDIO SYNTH (No external audio files)
    // =========================================================================
    class SoundSynth {
      constructor() {
        this.ctx = null;
      }
      ensureCtx() {
        if (!state.soundEnabled) return null;
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) this.ctx = new AudioCtx();
        }
        if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();
        return this.ctx;
      }
      playClick(freq = 520) {
        const ctx = this.ensureCtx();
        if (!ctx) return;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(140, ctx.currentTime + 0.06);
        gain.gain.setValueAtTime(0.14, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.065);
        osc.connect(gain); gain.connect(ctx.destination);
        osc.start(); osc.stop(ctx.currentTime + 0.07);
      }
      playPop(up = true) {
        const ctx = this.ensureCtx();
        if (!ctx) return;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        const startF = up ? 220 : 480;
        const endF = up ? 580 : 190;
        osc.frequency.setValueAtTime(startF, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(endF, ctx.currentTime + 0.14);
        gain.gain.setValueAtTime(0.15, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);
        osc.connect(gain); gain.connect(ctx.destination);
        osc.start(); osc.stop(ctx.currentTime + 0.16);
      }
      playRustle() {
        const ctx = this.ensureCtx();
        if (!ctx) return;
        const bufferSize = ctx.sampleRate * 0.35;
        const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          data[i] = (Math.random() * 2 - 1) * Math.sin((i / bufferSize) * Math.PI);
        }
        const noise = ctx.createBufferSource();
        noise.buffer = buffer;
        const filter = ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(950, ctx.currentTime);
        filter.Q.value = 1.4;
        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0.16, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.34);
        noise.connect(filter); filter.connect(gain); gain.connect(ctx.destination);
        noise.start();
      }
      playChime(success = true) {
        const ctx = this.ensureCtx();
        if (!ctx) return;
        const notes = success ? [523.25, 659.25, 783.99] : [311.13, 277.18];
        notes.forEach((f, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          const t0 = ctx.currentTime + idx * 0.08;
          osc.frequency.setValueAtTime(f, t0);
          gain.gain.setValueAtTime(0.12, t0);
          gain.gain.exponentialRampToValueAtTime(0.001, t0 + 0.22);
          osc.connect(gain); gain.connect(ctx.destination);
          osc.start(t0); osc.stop(t0 + 0.24);
        });
      }
    }
    const synth = new SoundSynth();

    // =========================================================================
    // 3. PROCEDURAL CANVAS TEXTURES (Paper, Wood, Cloth, Blinds Light)
    // =========================================================================
    function createWoodTexture() {
      const c = document.createElement('canvas');
      c.width = 512; c.height = 512;
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#5c3d28';
      ctx.fillRect(0, 0, 512, 512);
      for (let y = 0; y < 512; y += 2) {
        const tone = 68 + Math.sin(y * 0.07) * 14 + (Math.random() - 0.5) * 10;
        ctx.fillStyle = `rgb(${tone + 26}, ${tone}, ${Math.max(20, tone - 22)})`;
        ctx.fillRect(0, y, 512, 2);
      }
      const tex = new THREE.CanvasTexture(c);
      tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
      tex.repeat.set(3, 3);
      return tex;
    }

    function createClothTexture() {
      const c = document.createElement('canvas');
      c.width = 256; c.height = 256;
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#1b544e';
      ctx.fillRect(0, 0, 256, 256);
      ctx.fillStyle = 'rgba(255,255,255,0.06)';
      for (let i = 0; i < 256; i += 4) {
        ctx.fillRect(i, 0, 1, 256);
        ctx.fillRect(0, i, 256, 1);
      }
      const tex = new THREE.CanvasTexture(c);
      tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
      tex.repeat.set(6, 6);
      return tex;
    }

    function createPaperTexture() {
      const c = document.createElement('canvas');
      c.width = 512; c.height = 512;
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#fbf6ea';
      ctx.fillRect(0, 0, 512, 512);
      for (let i = 0; i < 4000; i++) {
        const x = Math.random() * 512;
        const y = Math.random() * 512;
        ctx.fillStyle = Math.random() > 0.5 ? 'rgba(180,165,140,0.08)' : 'rgba(255,255,255,0.12)';
        ctx.fillRect(x, y, 2, 2);
      }
      // Subtle grid lines for anatomical stage
      ctx.strokeStyle = 'rgba(29, 107, 100, 0.08)';
      ctx.lineWidth = 1;
      for (let g = 32; g < 512; g += 32) {
        ctx.beginPath(); ctx.moveTo(g, 0); ctx.lineTo(g, 512); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(0, g); ctx.lineTo(512, g); ctx.stroke();
      }
      const tex = new THREE.CanvasTexture(c);
      return tex;
    }

    // =========================================================================
    // 4. THREE.JS SCENE, RENDERERS, POST-PROCESSING & CAMERA CONTROLS
    // =========================================================================
    const webglContainer = document.getElementById('webgl-container');
    const css3dContainer = document.getElementById('css3d-container');

    function getSafeAspect() {
      const w = window.innerWidth || 1280;
      const h = window.innerHeight || 800;
      const aspect = w / h;
      return (!isFinite(aspect) || aspect <= 0) ? (16 / 10) : aspect;
    }

    const scene = new THREE.Scene();
    scene.background = new THREE.Color('#232b35');
    scene.fog = new THREE.FogExp2('#232b35', 0.032);

    const camera = new THREE.PerspectiveCamera(38, getSafeAspect(), 0.1, 60);

    const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.setSize(window.innerWidth || 1280, window.innerHeight || 800);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.08;
    webglContainer.appendChild(renderer.domElement);

    const cssRenderer = new CSS3DRenderer();
    cssRenderer.setSize(window.innerWidth || 1280, window.innerHeight || 800);
    css3dContainer.appendChild(cssRenderer.domElement);

    // Subtle Paper Grain + Vignette Post-Processing Shader
    const composer = new EffectComposer(renderer);
    const renderPass = new RenderPass(scene, camera);
    composer.addPass(renderPass);

    const PaperVignetteShader = {
      uniforms: {
        tDiffuse: { value: null },
        uTime: { value: 0.0 }
      },
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform sampler2D tDiffuse;
        uniform float uTime;
        varying vec2 vUv;
        float rand(vec2 co) {
          return fract(sin(dot(co.xy, vec2(12.9898, 78.233))) * 43758.5453);
        }
        void main() {
          vec4 texel = texture2D(tDiffuse, vUv);
          vec2 dist = vUv - 0.5;
          float vig = smoothstep(0.85, 0.25, length(dist));
          float grain = (rand(vUv + fract(uTime * 0.05)) - 0.5) * 0.022;
          vec3 col = texel.rgb * mix(0.84, 1.03, vig) + grain;
          gl_FragColor = vec4(col, texel.a);
        }
      `
    };
    const postPass = new ShaderPass(PaperVignetteShader);
    composer.addPass(postPass);

    // OrbitControls with sensible desk limits
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.065;
    controls.maxPolarAngle = Math.PI * 0.455; // Never go below the desk
    controls.minPolarAngle = 0.12;
    controls.minDistance = 2.6;
    controls.maxDistance = 12.5;
    controls.panSpeed = 0.8;
    controls.rotateSpeed = 0.75;
    controls.target.set(0, 0.25, 0);

    // Stop guided demo immediately if user manually grabs the camera
    controls.addEventListener('start', () => {
      if (state.isDemoPlaying) {
        stopDemo(true);
      }
    });

    function getDefaultCameraPose() {
      const aspect = getSafeAspect();
      // Frame the entire open spread (width ~5.6 units) even on portrait phone screens
      const dist = aspect < 1.0 ? (7.4 / Math.max(aspect, 0.48)) : 6.1;
      return {
        pos: new THREE.Vector3(0, dist * 0.78, dist * 0.72),
        target: new THREE.Vector3(0, 0.22, 0.05)
      };
    }

    function resetCamera(instant = false) {
      const pose = getDefaultCameraPose();
      if (instant || state.reducedMotion) {
        camera.position.copy(pose.pos);
        controls.target.copy(pose.target);
        controls.update();
      } else {
        gsap.to(camera.position, { x: pose.pos.x, y: pose.pos.y, z: pose.pos.z, duration: 0.9, ease: 'power2.inOut' });
        gsap.to(controls.target, {
          x: pose.target.x, y: pose.target.y, z: pose.target.z, duration: 0.9, ease: 'power2.inOut',
          onUpdate: () => controls.update()
        });
      }
    }
    resetCamera(true);

    // =========================================================================
    // 5. LIGHTING & POP-UP BOOK ARCHITECTURE
    // =========================================================================
    const hemiLight = new THREE.HemisphereLight('#fffdf8', '#465261', 0.85);
    scene.add(hemiLight);

    const dirLight = new THREE.DirectionalLight('#fff7e8', 1.45);
    dirLight.position.set(3.5, 6.5, 4.2);
    dirLight.castShadow = true;
    dirLight.shadow.mapSize.set(2048, 2048);
    dirLight.shadow.camera.near = 1;
    dirLight.shadow.camera.far = 18;
    const d = 4.5;
    dirLight.shadow.camera.left = -d;
    dirLight.shadow.camera.right = d;
    dirLight.shadow.camera.top = d;
    dirLight.shadow.camera.bottom = -d;
    dirLight.shadow.bias = -0.0005;
    scene.add(dirLight);

    const rimLight = new THREE.DirectionalLight('#9ad8d0', 0.45);
    rimLight.position.set(-4, 3, -3);
    scene.add(rimLight);

    // Desk Surface
    const deskGeo = new THREE.PlaneGeometry(28, 28);
    const deskMat = new THREE.MeshStandardMaterial({ map: createWoodTexture(), roughness: 0.78, metalness: 0.05 });
    const desk = new THREE.Mesh(deskGeo, deskMat);
    desk.rotation.x = -Math.PI / 2;
    desk.receiveShadow = true;
    scene.add(desk);

    // Book Base Group
    const bookGroup = new THREE.Group();
    scene.add(bookGroup);

    const PAGE_W = 2.65;
    const PAGE_D = 3.35;
    const PAGE_H = 0.05;

    // Hardcover Boards
    const coverMat = new THREE.MeshStandardMaterial({ map: createClothTexture(), roughness: 0.85 });
    const leftCover = new THREE.Mesh(new THREE.BoxGeometry(PAGE_W + 0.14, 0.06, PAGE_D + 0.16), coverMat);
    leftCover.position.set(-PAGE_W / 2 - 0.04, 0.03, 0);
    leftCover.receiveShadow = true;
    leftCover.castShadow = true;
    bookGroup.add(leftCover);

    const rightCover = new THREE.Mesh(new THREE.BoxGeometry(PAGE_W + 0.14, 0.06, PAGE_D + 0.16), coverMat);
    rightCover.position.set(PAGE_W / 2 + 0.04, 0.03, 0);
    rightCover.receiveShadow = true;
    rightCover.castShadow = true;
    bookGroup.add(rightCover);

    const spineMesh = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.065, PAGE_D + 0.16), coverMat);
    spineMesh.position.set(0, 0.032, 0);
    bookGroup.add(spineMesh);

    // Paper Blocks (Left & Right Pages)
    const paperMat = new THREE.MeshStandardMaterial({ map: createPaperTexture(), roughness: 0.88 });
    const leftPageMesh = new THREE.Mesh(new THREE.BoxGeometry(PAGE_W, PAGE_H, PAGE_D), paperMat);
    leftPageMesh.position.set(-PAGE_W / 2 - 0.01, 0.085, 0);
    leftPageMesh.receiveShadow = true;
    bookGroup.add(leftPageMesh);

    const rightPageMesh = new THREE.Mesh(new THREE.BoxGeometry(PAGE_W, PAGE_H, PAGE_D), paperMat);
    rightPageMesh.position.set(PAGE_W / 2 + 0.01, 0.085, 0);
    rightPageMesh.receiveShadow = true;
    bookGroup.add(rightPageMesh);

    // Spine crease shadow strip
    const creaseMesh = new THREE.Mesh(
      new THREE.PlaneGeometry(0.12, PAGE_D),
      new THREE.MeshBasicMaterial({ color: '#c8beae', side: THREE.DoubleSide })
    );
    creaseMesh.rotation.x = -Math.PI / 2;
    creaseMesh.position.set(0, 0.112, 0);
    bookGroup.add(creaseMesh);

    // Curling Sheet Mesh for 3D Page-Turn Transition
    const turnGeo = new THREE.PlaneGeometry(PAGE_W, PAGE_D, 24, 12);
    turnGeo.translate(PAGE_W / 2, 0, 0); // Pivot at spine x=0
    turnGeo.rotateX(-Math.PI / 2);
    const turnMat = new THREE.MeshStandardMaterial({
      map: createPaperTexture(),
      roughness: 0.82,
      side: THREE.DoubleSide
    });
    const turningSheet = new THREE.Mesh(turnGeo, turnMat);
    turningSheet.position.set(0, 0.118, 0);
    turningSheet.visible = false;
    turningSheet.castShadow = true;
    bookGroup.add(turningSheet);

    function deformTurningSheet(progress) {
      // progress: 0 (right page) -> 1 (left page)
      const pos = turnGeo.attributes.position;
      const arch = Math.sin(progress * Math.PI);
      for (let i = 0; i < pos.count; i++) {
        const x = pos.getX(i); // 0 to PAGE_W
        const normX = x / PAGE_W;
        const curlY = Math.sin(normX * Math.PI) * arch * 0.42;
        pos.setY(i, curlY);
      }
      pos.needsUpdate = true;
      turnGeo.computeVertexNormals();
      turningSheet.rotation.z = progress * Math.PI;
    }

    // =========================================================================
    // 6. LEFT PAGE CSS3D OBJECT (Crisp HTML/CSS + Wheel Forwarding)
    // =========================================================================
    const leftPageEl = document.createElement('div');
    leftPageEl.className = 'book-left-page';
    leftPageEl.innerHTML = `<div id="left-page-inner"></div>`;

    // Forward mouse wheel from HTML page to WebGL canvas so zoom works everywhere
    leftPageEl.addEventListener('wheel', (e) => {
      // Only forward if the user isn't scrolling inside overflowing text, or forward when ctrl/zooming
      const atTop = leftPageEl.scrollTop <= 0 && e.deltaY < 0;
      const atBottom = (leftPageEl.scrollTop + leftPageEl.clientHeight >= leftPageEl.scrollHeight - 2) && e.deltaY > 0;
      if (atTop || atBottom || e.ctrlKey) {
        const cloned = new WheelEvent('wheel', {
          deltaX: e.deltaX, deltaY: e.deltaY, deltaZ: e.deltaZ,
          deltaMode: e.deltaMode, clientX: e.clientX, clientY: e.clientY,
          bubbles: true, cancelable: true
        });
        renderer.domElement.dispatchEvent(cloned);
      }
    }, { passive: true });

    const cssPageObj = new CSS3DObject(leftPageEl);
    // Scale 680x860 CSS px into PAGE_W x PAGE_D (2.65 x 3.35 world units)
    const cssScale = PAGE_W / 680;
    cssPageObj.scale.set(cssScale, cssScale, cssScale);
    cssPageObj.rotation.x = -Math.PI / 2;
    cssPageObj.position.set(-PAGE_W / 2 - 0.01, 0.114, 0);
    bookGroup.add(cssPageObj);

    // =========================================================================
    // 7. RIGHT PAGE POP-UP STAGE & CANVAS CALLOUT LABELS
    // =========================================================================
    const popupRoot = new THREE.Group();
    popupRoot.position.set(PAGE_W / 2 + 0.01, 0.112, 0);
    bookGroup.add(popupRoot);

    const labelsGroup = new THREE.Group();
    popupRoot.add(labelsGroup);

    function trackGeo(g) { state.disposables.geometries.push(g); return g; }
    function trackMat(m) { state.disposables.materials.push(m); return m; }
    function trackTex(t) { state.disposables.textures.push(t); return t; }

    function clearPopupStage() {
      state.interactiveMeshes = [];
      while (popupRoot.children.length > 0) {
        const child = popupRoot.children[0];
        popupRoot.remove(child);
      }
      while (labelsGroup.children.length > 0) {
        labelsGroup.remove(labelsGroup.children[0]);
      }
      state.disposables.geometries.forEach(g => g.dispose());
      state.disposables.materials.forEach(m => m.dispose());
      state.disposables.textures.forEach(t => t.dispose());
      state.disposables = { geometries: [], materials: [], textures: [] };
      popupRoot.add(labelsGroup);
    }

    function createLabelSprite(text, anchor = 'center') {
      const canvas = document.createElement('canvas');
      canvas.width = 512;
      canvas.height = 96;
      const ctx = canvas.getContext('2d');
      ctx.font = '700 26px "Plus Jakarta Sans", sans-serif';
      const metrics = ctx.measureText(text);
      const boxW = Math.min(490, Math.max(180, metrics.width + 44));
      const boxH = 58;
      const x = (512 - boxW) / 2;
      const y = (96 - boxH) / 2;

      ctx.fillStyle = state.themeIndex === 1 ? 'rgba(24, 30, 40, 0.92)' : 'rgba(255, 252, 245, 0.94)';
      ctx.beginPath();
      ctx.roundRect(x, y, boxW, boxH, 16);
      ctx.fill();

      ctx.strokeStyle = state.themeIndex === 1 ? '#4ecdc4' : '#1d6b64';
      ctx.lineWidth = 4;
      ctx.stroke();

      ctx.fillStyle = state.themeIndex === 1 ? '#eef2f7' : '#1e242b';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, 256, 49);

      const tex = trackTex(new THREE.CanvasTexture(canvas));
      const mat = trackMat(new THREE.SpriteMaterial({ map: tex, depthTest: false }));
      const sprite = new THREE.Sprite(mat);
      sprite.scale.set(1.05, 0.2, 1);
      return sprite;
    }

    function buildPageLabels(lesson) {
      if (!lesson.pageLabels) return;
      lesson.pageLabels.forEach(lbl => {
        const sp = createLabelSprite(lbl.text, lbl.anchor);
        sp.position.set(lbl.position[0], lbl.position[1], lbl.position[2]);
        labelsGroup.add(sp);
      });
    }

    // Helper: Stylized Anatomical Infant Bust Builder (used across lessons)
    function createInfantModel(options = {}) {
      const group = new THREE.Group();
      const skinMat = trackMat(new THREE.MeshStandardMaterial({ color: '#f4c7a8', roughness: 0.6 }));
      const clothMat = trackMat(new THREE.MeshStandardMaterial({ color: '#64a6bd', roughness: 0.75 }));
      const scmRetractedMat = trackMat(new THREE.MeshStandardMaterial({
        color: '#d9483b', emissive: '#59120b', emissiveIntensity: 0.25, roughness: 0.45
      }));
      const scmHealthyMat = trackMat(new THREE.MeshStandardMaterial({
        color: '#3ca374', emissive: '#0c3b25', emissiveIntensity: 0.15, roughness: 0.5
      }));

      // Torso
      const torso = new THREE.Mesh(trackGeo(new THREE.CylinderGeometry(0.32, 0.36, 0.62, 24)), clothMat);
      torso.position.y = 0.31;
      torso.castShadow = true;
      group.add(torso);

      // Shoulders / Clavicles
      const shoulders = new THREE.Mesh(trackGeo(new THREE.CapsuleGeometry(0.13, 0.56, 12, 20)), clothMat);
      shoulders.rotation.z = Math.PI / 2;
      shoulders.position.y = 0.58;
      shoulders.castShadow = true;
      group.add(shoulders);

